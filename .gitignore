# --- R session / history ---
.Rhistory
.RData
.Rapp.history
.Ruserdata
*.Rproj.user/
.Rproj.user/

# --- R output caches ---
*_cache/
*_files/
/*_cache/
/*_files/

# --- large / regenerated analysis outputs ---
# (regenerated by the pipeline; keep the code, not the heavy artifacts)
Figures/
Models/
*.rds

# --- rendered reports ---
*.pdf
*.html
*.aux
*.log
*.out
*.tex

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*~
*.swp
.vscode/
.idea/

# --- data: do NOT commit raw third-party data ---
# GBIF / TRY / EVA / Heap DB and district crop stats carry their own terms.
# Commit small derived tables intentionally; ignore the rest by default.
*.xlsx
*.gpkg
*.tif
*.tiff
